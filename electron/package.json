{
  "name": "netseer-desktop",
  "productName": "NetSeer",
  "version": "0.6.4",
  "description": "Turn traffic into terrain. Electron shell for the NetSeer backend.",
  "author": {
    "name": "Ardyn Systems"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "systems.ardyn.netseer",
    "productName": "NetSeer",
    "artifactName": "NetSeer-Electron-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "preload.js"],
    "publish": [
      {
        "provider": "github",
        "owner": "ardyn-systems",
        "repo": "NetSeer"
      }
    ],
    "extraResources": [
      {
        "from": "../dist/netseer-server",
        "to": "netseer"
      },
      {
        "from": "../packaging/linux/netseer.png",
        "to": "icons/netseer.png"
      }
    ],
    "win": {
      "icon": "../packaging/windows/netseer.ico",
      "target": ["nsis", "zip"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NetSeer-Electron-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "../packaging/linux/netseer.png",
      "target": ["AppImage"],
      "category": "Network"
    }
  }
}
