{
  "name": "netseer-desktop",
  "productName": "NetSeer",
  "version": "0.6.4",
  "description": "Turn traffic into terrain. Electron shell for the NetSeer backend.",
  "author": {
    "name": "Ardyn Systems"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "systems.ardyn.netseer",
    "productName": "NetSeer",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "preload.js"],
    "extraResources": [
      {
        "from": "../dist/netseer-server",
        "to": "netseer"
      }
    ],
    "win": {
      "target": ["zip"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network"
    }
  }
}
